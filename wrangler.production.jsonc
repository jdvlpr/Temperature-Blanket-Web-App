// The deployed site, temperature-blanket.com, as a Cloudflare Worker built from
// main (Workers Builds runs `pnpm build`, then
// `npx wrangler deploy --config wrangler.production.jsonc`). wrangler.jsonc stays
// the local dev and test configuration.
//
// It was the version 7 beta at next.temperature-blanket.com. For a few weeks
// after launch it answers there too (the retired beta: RetiredBetaBanner, Move
// My Projects to /from-beta, noindex); then that route goes and next.* gets an
// "ended" redirect. Older versions stay on the Pages project
// temperature-blanket-web-app as archive-vN branches (archive-vN.temperature-blanket.com).
//
// Where settings live:
// - Build time (PUBLIC_*, SECRET_*, inlined by `pnpm build`): the Worker's
//   Settings › Build › Variables and secrets, since this file is read only at deploy.
//   It sets PUBLIC_ACCOUNTS_ENABLED=true; PUBLIC_SITE_CHANNEL is unset (=beta
//   only for a beta build).
// - Runtime, not secret: `vars` below (a deploy replaces what's in the dashboard).
// - Runtime secrets (BETTER_AUTH_SECRET, GOOGLE_CLIENT_SECRET,
//   RAVELRY_CLIENT_SECRET, TURNSTILE_SECRET_KEY for guests' beta feedback with
//   PUBLIC_TURNSTILE_SITE_KEY at build time, BETA_FEEDBACK_OWNERS: the emails
//   that may read it on /beta/feedback): `wrangler secret put <NAME> --config wrangler.production.jsonc`.
//   Deploys keep them.
//
// The adapter builds for Workers in Workers Builds (WORKERS_CI), writing the
// Worker and its static files to .svelte-kit/cloudflare as for Pages; run
// `WORKERS_CI=1 pnpm build` to build the same way locally.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "temperature-blanket",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare",
  },
  "routes": [
    { "pattern": "temperature-blanket.com", "custom_domain": true },
    // The retired beta, for a few weeks after launch
    { "pattern": "next.temperature-blanket.com", "custom_domain": true },
  ],
  "workers_dev": false,
  "preview_urls": false,
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tb-accounts-us",
      "database_id": "8813aeb8-0d5a-45f3-969d-084a7c98dcdf",
      "migrations_dir": "migrations",
    },
  ],
  "r2_buckets": [{ "binding": "PROJECTS", "bucket_name": "tb-projects-us" }],
  "vars": {
    "ACCOUNTS_ENABLED": "true",
    "SYNC_ENABLED": "true",
    "GALLERY_PUBLISH_ENABLED": "true",
    // ACCOUNTS_SIGNUP_LIMIT unset: no limit. A number caps accounts (0 closes sign-ups)
    "AUTH_ALLOWED_HOSTS": "next.temperature-blanket.com,temperature-blanket.com",
    "AUTH_PROTOCOL": "https",
    // Google is the only sign-in (EMAIL_SIGN_IN unset), so nothing is emailed
    "GOOGLE_CLIENT_ID": "791075822244-d58b98jg0iah5t0e0a9c6oup319r6hvg.apps.googleusercontent.com",
    "RAVELRY_CLIENT_ID": "537c8e1c8f8c09a3776f12b69a95958b",
  },
}
